{
  "name": "javascript-boilerplate",
  "version": "2.0.0",
  "description": "This is a sample javascript boilerplate using express, mongodb, mysql, and more... .",
  "main": "./src/server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "test": "jest --updateSnapshot --detectOpenHandles --coverage --forceExit --verbose",
    "run": "pm2 start ./src/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amin-abbasi/javascript-boilerplate.git"
  },
  "keywords": [
    "javascript",
    "boilerplate"
  ],
  "author": "AAH",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amin-abbasi/javascript-boilerplate/issues"
  },
  "homepage": "https://github.com/amin-abbasi/javascript-boilerplate.git#readme",
  "dependencies": {
    "axios": "1.13.5",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "gach": "1.7.5",
    "helmet": "8.1.0",
    "joi": "18.0.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.2.1",
    "mongoose-unique-validator": "5.0.2",
    "mysql": "2.18.1",
    "redis": "5.11.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "eslint": "10.0.0",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "supertest": "7.2.2"
  }
}
